From 161f822062259d33f0b853bd02800fc7946dc130 Mon Sep 17 00:00:00 2001
From: je991707-star <je.991707@gmail.com>
Date: Sat, 21 Nov 2026 02:00:56 +0800
Subject: [PATCH 1/3] gtelwifi: enable SoftAP tethering and use mini Lineage
 product

- overlay: tether over wlan0/softap0, upstream types 0,1,5,7
- net.tethering.noprovisioning=true for SIM-less tablet
- inherit common_mini_tablet_wifionly to drop non-essential apps

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Change-Id: I509c2048671dc0f1eb4f57bf3feb5c766df8d487
---
 gtelwifi.mk                                        |  4 ++++
 lineage_gtelwifi.mk                                |  2 +-
 .../frameworks/base/core/res/res/values/config.xml | 14 ++++++++++++++
 3 files changed, 19 insertions(+), 1 deletion(-)

diff --git a/gtelwifi.mk b/gtelwifi.mk
index 1dbd579..8b0fb19 100644
--- a/gtelwifi.mk
+++ b/gtelwifi.mk
@@ -57,6 +57,10 @@ PRODUCT_PACKAGES += \
 # WiFi
 $(call inherit-product, hardware/broadcom/wlan/bcmdhd/config/config-bcm.mk)
 
+# SoftAP: no carrier entitlement check on a SIM-less tablet
+PRODUCT_PROPERTY_OVERRIDES += \
+	net.tethering.noprovisioning=true
+
 # Set those variables here to overwrite the inherited values.
 PRODUCT_NAME := full_gtelwifi
 PRODUCT_DEVICE := gtelwifi
diff --git a/lineage_gtelwifi.mk b/lineage_gtelwifi.mk
index ca9e8ab..cdc7d79 100644
--- a/lineage_gtelwifi.mk
+++ b/lineage_gtelwifi.mk
@@ -4,7 +4,7 @@
 PRODUCT_RELEASE_NAME := gtelwifi
 
 # Inherit some common Lineage stuff.
-$(call inherit-product, vendor/lineage/config/common_full_tablet_wifionly.mk)
+$(call inherit-product, vendor/lineage/config/common_mini_tablet_wifionly.mk)
 
 # Inherit device configuration
 $(call inherit-product, device/samsung/gtelwifi/gtelwifi.mk)
diff --git a/overlay/frameworks/base/core/res/res/values/config.xml b/overlay/frameworks/base/core/res/res/values/config.xml
index 4be78ee..380bcb3 100644
--- a/overlay/frameworks/base/core/res/res/values/config.xml
+++ b/overlay/frameworks/base/core/res/res/values/config.xml
@@ -5,4 +5,18 @@
          reclaim before foreground allocations enter direct reclaim.
     -->
     <integer name="config_extraFreeKbytesAbsolute">24576</integer>
+
+    <!-- SoftAP: interfaces hostapd may bring up for Wi-Fi tethering -->
+    <string-array translatable="false" name="config_tether_wifi_regexs">
+        <item>"wlan0"</item>
+        <item>"softap0"</item>
+    </string-array>
+
+    <!-- Wi-Fi only tablet: TYPE_MOBILE, TYPE_WIFI, TYPE_MOBILE_HIPRI, TYPE_BLUETOOTH -->
+    <integer-array translatable="false" name="config_tether_upstream_types">
+        <item>0</item>
+        <item>1</item>
+        <item>5</item>
+        <item>7</item>
+    </integer-array>
 </resources>
-- 
2.17.1

