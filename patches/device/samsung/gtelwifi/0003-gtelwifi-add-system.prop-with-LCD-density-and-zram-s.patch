From 1413fe5808c750a86601a835278d011f72cb42e8 Mon Sep 17 00:00:00 2001
From: je991707-star <je.991707@gmail.com>
Date: Sat, 21 Nov 2026 13:01:07 +0800
Subject: [PATCH 3/3] gtelwifi: add system.prop with LCD density and zram
 settings

Without ro.sf.lcd_density SurfaceFlinger used the bogus HWC DPI (20320),
pushing all UI off-screen (blank white screen after boot). swap.rc also
needs ro.config.swappiness / ro.config.zram.disksize to enable zram.
Values match the gtel3g (SM-T561) tree, which shares the panel.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Change-Id: Ife43d6f8e4568197194924d4059e61a407833f58
---
 BoardConfig.mk | 2 ++
 system.prop    | 8 ++++++++
 2 files changed, 10 insertions(+)
 create mode 100644 system.prop

diff --git a/BoardConfig.mk b/BoardConfig.mk
index 7721695..f3c4427 100644
--- a/BoardConfig.mk
+++ b/BoardConfig.mk
@@ -18,6 +18,8 @@
 # Inherit from the proprietary version
 -include vendor/samsung/gtelwifi/BoardConfigVendor.mk
 
+TARGET_SYSTEM_PROP += device/samsung/gtelwifi/system.prop
+
 # The SPRD audio HAL links against libatchannel, which is gated by this flag.
 # No radio service is included in the gtelwifi product.
 BOARD_PROVIDES_LIBRIL := true
diff --git a/system.prop b/system.prop
new file mode 100644
index 0000000..7cacaf1
--- /dev/null
+++ b/system.prop
@@ -0,0 +1,8 @@
+# Display: without this SurfaceFlinger falls back to the bogus HWC DPI (20320)
+ro.sf.lcd_density=213
+ro.sf.lcd_width=129
+ro.sf.lcd_height=207
+
+# Memory: consumed by scx35-common swap.rc (zram stays off when unset)
+ro.config.swappiness=100
+ro.config.zram.disksize=512M
-- 
