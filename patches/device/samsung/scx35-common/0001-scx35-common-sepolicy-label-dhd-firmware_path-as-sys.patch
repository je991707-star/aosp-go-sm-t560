--- a/sepolicy/genfs_contexts
+++ b/sepolicy/genfs_contexts
@@ -4,3 +4,4 @@ genfscon proc /cpt u:object_r:proc_cpt:s0
 genfscon sysfs /devices/system/cpu/cpuhotplug/cpu_num_min_limit u:object_r:sysfs_sprd_cpuhotplug:s0
 genfscon sysfs /power/gpufreq_min_limit u:object_r:sysfs_sprd_gpufreq:s0
 genfscon sysfs /class/input/nav_keys_disabled u:object_r:sysfs_nav_keys:s0
